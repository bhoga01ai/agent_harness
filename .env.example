# Copy to .env (project root) and fill in one option. Both `adk web` and improve-harness read it.

# Option 1: Google AI Studio key (https://aistudio.google.com/app/apikey)
GOOGLE_GENAI_USE_ENTERPRISE=FALSE
GOOGLE_API_KEY=YOUR_API_KEY

# Option 2: Vertex AI (after `gcloud auth application-default login`)
# GOOGLE_GENAI_USE_ENTERPRISE=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional: models. Solver = the ADK agent; improver = Claude Code editor/selector.
# HARNESS2_ADK_MODEL=gemini-2.5-flash
# HARNESS2_IMPROVER_MODEL=claude-sonnet-5-5
# HARNESS2_JUDGE_MODEL=gemini-2.5-flash
# Set to 1 to run the Claude Code editor on Vertex AI instead of your local login:
# HARNESS2_CLAUDE_VERTEX=1
